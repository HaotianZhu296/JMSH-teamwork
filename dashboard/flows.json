[
    {
        "id": "mhd-tab",
        "type": "tab",
        "label": "Machine Overheating Detection",
        "disabled": false
    },
    {
        "id": "ui-tab",
        "type": "ui_tab",
        "name": "Live Monitor",
        "icon": "dashboard",
        "order": 1
    },
    {
        "id": "ui-group-temp",
        "type": "ui_group",
        "name": "Temperature",
        "tab": "ui-tab",
        "order": 1,
        "width": 12
    },
    {
        "id": "ui-group-alerts",
        "type": "ui_group",
        "name": "Alerts",
        "tab": "ui-tab",
        "order": 2,
        "width": 12
    },
    {
        "id": "ui-group-stats",
        "type": "ui_group",
        "name": "Machine Stats",
        "tab": "ui-tab",
        "order": 3,
        "width": 12
    },
    {
        "id": "mqtt-telemetry",
        "type": "mqtt in",
        "z": "mhd-tab",
        "name": "Telemetry",
        "topic": "sensors/+/telemetry",
        "qos": "1",
        "datatype": "json",
        "broker": "mqtt-broker",
        "x": 130,
        "y": 80,
        "wires": [["parse-telemetry"]]
    },
    {
        "id": "parse-telemetry",
        "type": "function",
        "z": "mhd-tab",
        "name": "Parse telemetry",
        "func": "var data = msg.payload;\nmsg.topic = data.machineId || data.machine_id || msg.topic.split('/')[1];\nmsg.payload = data.processTemperature || data.process_temp_k || data.processTempK || 0;\nreturn msg;",
        "x": 330,
        "y": 80,
        "wires": [["chart-temp", "gauge-temp"]]
    },
    {
        "id": "chart-temp",
        "type": "ui_chart",
        "z": "mhd-tab",
        "name": "Temperature Trend",
        "group": "ui-group-temp",
        "order": 1,
        "width": 12,
        "height": 6,
        "label": "Process Temperature (°C)",
        "chartType": "line",
        "legend": "true",
        "xformat": "HH:mm:ss",
        "interpolate": "linear",
        "nodata": "Waiting for data...",
        "ymin": "0",
        "ymax": "150",
        "removeOlder": "5",
        "removeOlderUnit": "60",
        "x": 550,
        "y": 60,
        "wires": [[]]
    },
    {
        "id": "gauge-temp",
        "type": "ui_gauge",
        "z": "mhd-tab",
        "name": "Current Temp",
        "group": "ui-group-stats",
        "order": 1,
        "width": 4,
        "height": 4,
        "gtype": "gage",
        "title": "Process Temp (°C)",
        "label": "°C",
        "format": "{{value | number:1}}",
        "min": "0",
        "max": "150",
        "seg1": "80",
        "seg2": "95",
        "x": 550,
        "y": 120,
        "wires": []
    },
    {
        "id": "mqtt-alerts",
        "type": "mqtt in",
        "z": "mhd-tab",
        "name": "Alerts",
        "topic": "alerts/#",
        "qos": "1",
        "datatype": "json",
        "broker": "mqtt-broker",
        "x": 130,
        "y": 200,
        "wires": [["format-alert"]]
    },
    {
        "id": "format-alert",
        "type": "function",
        "z": "mhd-tab",
        "name": "Format alert",
        "func": "var a = msg.payload;\nvar ts = new Date(a.timestamp || a.timestampMs || Date.now());\nvar line = ts.toLocaleTimeString() + ' | ' + (a.severity || 'UNKNOWN') + ' | ' + (a.machine_id || a.machineId || '?') + ' | ' + (a.reason || a.detector || '');\nmsg.payload = line;\nreturn msg;",
        "x": 330,
        "y": 200,
        "wires": [["alert-log", "alert-notify"]]
    },
    {
        "id": "alert-log",
        "type": "ui_text",
        "z": "mhd-tab",
        "name": "Alert Feed",
        "group": "ui-group-alerts",
        "order": 1,
        "width": 12,
        "height": 4,
        "label": "Latest Alert",
        "format": "{{msg.payload}}",
        "layout": "row-spread",
        "x": 550,
        "y": 180,
        "wires": []
    },
    {
        "id": "alert-notify",
        "type": "ui_toast",
        "z": "mhd-tab",
        "name": "Alert Toast",
        "position": "top right",
        "displayTime": "5",
        "highlight": "",
        "sendall": true,
        "outputs": 0,
        "ok": "OK",
        "cancel": "",
        "raw": false,
        "topic": "",
        "x": 550,
        "y": 240,
        "wires": []
    },
    {
        "id": "mqtt-broker",
        "type": "mqtt-broker",
        "name": "MHD Broker",
        "broker": "mosquitto",
        "port": "1883",
        "clientid": "dashboard",
        "autoConnect": true,
        "usetls": false,
        "protocolVersion": "4",
        "keepalive": "60",
        "cleansession": true,
        "credentials": {
            "user": "dashboard",
            "password": "dash_pass_2024"
        }
    }
]
